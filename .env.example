# ---------------------------------------------------------------------------
# IPO Poster Studio - environment template (copy to .env and fill in)
# NEVER commit a filled-in .env. Both apps read env vars at runtime.
# ---------------------------------------------------------------------------

# --- Backend (FastAPI) ---
APP_NAME=IPO Poster Studio
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

# Comma separated list of frontend origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# Seeded admin account (change immediately in any shared/production environment)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
AUTH_ALLOW_REGISTER=true

# --- IPO data source --------------------------------------------------------
# demo      -> sample records, no external requests (default, fully offline)
# authorized-> only runs with ALL of: URL + API key + written permission flag
# ipopremium-> one-shot scrape of the PUBLIC ipopremium.in pages (robots.txt
#              allows / and /view/ipo/...), saved to IPO_LOCAL_DIR with the
#              company logos. Ended IPOs are auto-deleted from the local cache.
#              Re-scrape via admin "Re-scrape IPO data" button. Review
#              docs/DATA_SOURCE.md: commercial redistribution may need
#              written permission from the source owner.
IPO_SOURCE_MODE=demo
IPO_LOCAL_DIR=data/ipo_cache
IPO_SOURCE_URL=
IPO_SOURCE_API_KEY=
# Set to true ONLY after written permission to use the source is on file.
IPO_SOURCE_WRITTEN_PERMISSION=false
IPO_SOURCE_TIMEOUT_SECONDS=8
IPO_SOURCE_MAX_RETRIES=2
IPO_SOURCE_CACHE_TTL_SECONDS=300
STALE_AFTER_MINUTES=90

# --- Persistence ------------------------------------------------------------
# memory   -> no database, resets on cold start (demo / MVP)
# supabase -> managed Postgres for production accounts (run db/schema.sql)
PERSISTENCE=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Razorpay) ----------------------------------------------------
# test -> no live credentials; checkout is labelled TEST MODE
# live -> real checkout + signature-verified webhooks
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the secret configured on the Razorpay webhook endpoint
RAZORPAY_WEBHOOK_SECRET=

# --- Limits ---
MAX_BODY_BYTES=1000000
SESSION_TTL_SECONDS=604800
EXPORT_TOKEN_TTL_SECONDS=300

# --- Frontend (Next.js, prefix with NEXT_PUBLIC_) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
